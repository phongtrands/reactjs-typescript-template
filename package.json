  "scripts": {
    "ng": "nx",
    "start": "npm run lint && nx serve",
    "dev": "npm run lint && nx run-many --target=serve --projects=sapfin,epayment --parallel",
    "dev:sapfin": "nx lint sapfin && nx serve sapfin",
    "dev:epayment": "nx lint epayment && nx serve epayment",
    "build": "npm run lint && nx build",
    "graph": "nx graph",
    "lint": "nx run-many -t lint --skip-nx-cache"
  },
  "private": true,
  "devDependencies": {
