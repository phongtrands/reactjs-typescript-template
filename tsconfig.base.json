{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@datahub/components": ["libs/datahub/components/src/index.ts"],
      "@datahub/domain": ["libs/datahub/domain/src/index.ts"],
      "@datahub/feature": ["libs/datahub/feature/src/index.ts"],
      "@datahub/utils": ["libs/datahub/utils/src/index.ts"],
      "@shared/components": ["libs/shared/components/src/index.ts"],
      "@shared/services": ["libs/shared/services/src/index.ts"],
      "datahub/Module": ["apps/datahub/src/remote-entry.ts"],
      "sapfin/Module": ["apps/sapfin/src/remote-entry.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
