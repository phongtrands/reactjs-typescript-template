{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@core/components": ["libs/core/components/src/index.ts"],
      "@core/services": ["libs/core/services/src/index.ts"],
      "@core/types": ["libs/core/types/src/index.ts"],
      "@core/utils": ["libs/core/utils/src/index.ts"],
      "@libs/auth": ["libs/auth/src/index.ts"]
    }
  }
}
