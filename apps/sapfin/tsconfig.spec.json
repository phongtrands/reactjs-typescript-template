{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "moduleResolution": "node10",
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "module": "esnext",
    "esModuleInterop": true,
    "isolatedModules": false
  },
  "include": ["jest.config.ts", "**/*.ts", "**/*.tsx", "**/*.test.tsx", "**/*.spec.tsx"],
}
