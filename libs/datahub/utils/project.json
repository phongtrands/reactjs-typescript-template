{
  "name": "datahub-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/datahub/utils/src",
  "projectType": "library",
  "tags": ["type:utils", "scope:datahub"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/datahub/utils",
        "main": "libs/datahub/utils/src/index.ts",
        "tsConfig": "libs/datahub/utils/tsconfig.lib.json",
        "assets": ["libs/datahub/utils/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/datahub/utils/jest.config.ts"
      }
    }
  }
}
